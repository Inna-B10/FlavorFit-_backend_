{
	"moduleFileExtensions": ["js", "json", "ts", "tsx"],
	"rootDir": "..",
	"testEnvironment": "node",
	"testRegex": ".e2e-spec.ts$",
	"transform": {
		"^.+\\.(t|j)s$": "ts-jest"
	},
	"moduleNameMapper": {
		"^src/(.*)$": "<rootDir>/src/$1",
		"^prisma/(.*)$": "<rootDir>/prisma/$1",
		"^(\\.{1,2}/.*)\\.js$": "$1"
	}
}
